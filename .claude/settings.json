{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter pub get)",
      "Bash(flutter pub add:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter run:*)",
      "Bash(flutter screenshot:*)",
      "Bash(flutter doctor:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart run build_runner:*)",
      "Bash(npx supabase migration new:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(flutter build:*)"
    ],
    "deny": [
      "Read(./env/**)",
      "Edit(./env/**)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./android/key.properties)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/dart-check.sh\""
          }
        ]
      }
    ]
  }
}
